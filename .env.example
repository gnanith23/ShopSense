# ====================================================
# ShopSense - Environment Variables Template
# ====================================================
# Copy this file to the right location and fill in your values.
# NEVER commit real secrets to GitHub.
#
# For local development: copy to backend/.env
# For AWS EC2: set these as environment variables on the server
# ====================================================

# ---- Backend Settings ----
PORT=5000

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/shopsense?appName=<appname>

# Secret key used to sign JWT login tokens (make this a long random string)
JWT_SECRET=replace_with_a_long_random_secret_string

# OpenRouter AI API key (get from https://openrouter.ai)
OPENROUTER_API_KEY=sk-or-v1-replace-with-your-key

# URL of the FastAPI realtime service (used by backend to send sale events)
# Local: http://localhost:8000
# Docker Compose: http://realtime_service:8000
# EC2: http://<your-ec2-public-ip>:8000
FASTAPI_REALTIME_URL=http://localhost:8000

# ---- Frontend Settings ----
# The full URL of the backend REST API
# Local: http://localhost:5000/api
# EC2: http://<your-ec2-public-ip>:5000/api
VITE_API_URL=http://localhost:5000/api

# WebSocket URL for real-time vendor notifications
# Local: ws://localhost:8000
# EC2: ws://<your-ec2-public-ip>:8000
VITE_WS_URL=ws://localhost:8000

# ---- Optional: Email Service (Nodemailer) ----
# Used by the AI Agent to send weekly vendor reports
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password

# ---- Optional: Scheduler ----
# Cron expression for weekly AI agent (default: every Monday at 9 AM)
AI_AGENT_CRON=0 9 * * 1

# ---- Optional: Port Overrides ----
REALTIME_PORT=8000
BACKEND_PORT=5000
FRONTEND_PORT=8080
